{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "margpa://schemas/mutation_authorization_manifest/v1",
  "title": "Mutation Authorization Manifest",
  "description": "研究資産に対するMutationをFail-closedで承認するためのProject運用Schema。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mutation_id",
    "requested_by",
    "target_kind",
    "target_root",
    "allowed_paths",
    "allowed_actions",
    "forbidden_actions",
    "external_access",
    "follow_symlinks",
    "bulk_operation",
    "before_inventory_complete",
    "proposed_diff_presented",
    "backup_status",
    "rollback_plan_presented",
    "irreversible_effects_presented",
    "final_user_approval",
    "approval_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "mutation_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "const": "user"
    },
    "target_kind": {
      "enum": [
        "original_project",
        "user_copy",
        "public_copy",
        "explicit_external_target"
      ]
    },
    "target_root": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create",
          "edit",
          "replace",
          "move",
          "rename",
          "delete",
          "metadata",
          "permission"
        ]
      }
    },
    "forbidden_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "create",
          "edit",
          "replace",
          "move",
          "rename",
          "delete",
          "metadata",
          "permission",
          "external_access",
          "follow_symlinks"
        ]
      }
    },
    "external_access": {
      "enum": [
        "deny",
        "explicitly_approved"
      ]
    },
    "follow_symlinks": {
      "enum": [
        false,
        "explicitly_approved"
      ]
    },
    "bulk_operation": {
      "type": "boolean"
    },
    "before_inventory_complete": {
      "const": true
    },
    "proposed_diff_presented": {
      "const": true
    },
    "backup_status": {
      "const": "user_confirmed_complete"
    },
    "rollback_plan_presented": {
      "const": true
    },
    "irreversible_effects_presented": {
      "const": true
    },
    "final_user_approval": {
      "type": "string",
      "minLength": 1
    },
    "approval_scope": {
      "const": "single_operation"
    },
    "expires_after_operation": {
      "const": true,
      "default": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
